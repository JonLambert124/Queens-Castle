# Project One Move-Between-Rooms Pseudocode

START move_between_rooms

    SET current_room to the player's starting room
    SET game_over to FALSE

    WHILE game_over is FALSE

        OUTPUT "You are in the", current_room
        OUTPUT "Enter a movement command: go north, go south, go east, or go west"
        INPUT movement_command

        IF movement_command is "go north" OR
           movement_command is "go south" OR
           movement_command is "go east" OR
           movement_command is "go west" THEN

            SET direction to the direction contained in movement_command

            IF direction is an available exit from current_room THEN
                SET current_room to the room located in direction
                OUTPUT "You moved to the", current_room
            ELSE
                OUTPUT "You cannot go that way."
            END IF

        ELSE
            OUTPUT "Invalid command. Enter go north, go south, go east, or go west."
        END IF

        CHECK whether a win or loss condition has occurred
        IF a win or loss condition has occurred THEN
            SET game_over to TRUE
        END IF

    END WHILE

END move_between_rooms
