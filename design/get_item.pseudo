# Project One Get-Item Pseudocode

START get_item

    SET current_room to the player's current room
    SET room_item to the item located in current_room
    SET inventory to the player's current inventory

    OUTPUT "Enter get followed by the name of the item."
    INPUT item_command

    IF item_command begins with "get" THEN

        SET requested_item to the item named in item_command

        IF requested_item matches room_item THEN
            ADD room_item to inventory
            REMOVE room_item from current_room
            OUTPUT room_item, "was added to your inventory."
        ELSE
            OUTPUT "That item is not available in this room."
        END IF

    ELSE
        OUTPUT "Invalid command. Enter get followed by the item name."
    END IF

    OUTPUT "Inventory:", inventory
    RETURN to the main gameplay loop

END get_item
